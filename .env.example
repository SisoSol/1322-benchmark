# Copy this file to .env and fill in your own key, or export the variable
# directly in your shell. Never commit a real key.
#
# Get a 1322 API key from your dashboard at https://1322.io after signup.
# Use a normal-tier key for --tier normal, an ultimate-tier key for
# --tier ultimate (see README.md).

X1322_API_KEY=YOUR_API_KEY_HERE

# Alternate/generic name also accepted by the CLI, for use with --adapter
# generic against a non-1322 feed that needs an API key.
# API_KEY=YOUR_API_KEY_HERE
